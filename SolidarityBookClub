    <div class="hidden sm:block pointer-events-none absolute top-0 left-0 w-7 h-7 border-t-2 border-l-2 border-[#b58938]/60 rounded-tl-xl"></div>
    <div class="hidden sm:block pointer-events-none absolute top-0 right-0 w-7 h-7 border-t-2 border-r-2 border-[#b58938]/60 rounded-tr-xl"></div>
    <div class="hidden sm:block pointer-events-none absolute bottom-0 left-0 w-7 h-7 border-b-2 border-l-2 border-[#b58938]/60 rounded-bl-xl"></div>
    <div class="hidden sm:block pointer-events-none absolute bottom-0 right-0 w-7 h-7 border-b-2 border-r-2 border-[#b58938]/60 rounded-br-xl"></div>

    <div class="book-pages-stack">
      <div class="paper-surface px-5 py-6 sm:pl-20 sm:pr-10 sm:py-8 md:py-10 flex flex-col justify-between">
        <!-- Center Gutter Shadow on Desktop Spreads -->
        <div class="hidden lg:block book-spine-shadow"></div>

        <!-- Running Book Header -->
        <header class="flex flex-wrap items-center justify-between border-b border-[#1e1b18]/20 pb-2.5 mb-5 text-xs sm:text-sm text-[#4a433b] relative z-10">
          <div class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-[#a61c1c]"></span>
            <span class="uppercase tracking-widest font-semibold text-[11px] sm:text-xs">DSA Education Foundation · 501(c)(3)</span>
          </div>
          <div class="font-hand text-lg sm:text-xl text-[#a61c1c] font-bold">
            Prepared expressly for Three Avenues Bookshop — Chicago, IL
          </div>
        </header>

        <!-- SLIDES CONTAINER -->
        <div id="slides-wrapper" class="relative z-10 flex-grow flex items-center">

          <!-- ========================================================= -->
          <!-- SLIDE 1: COVER / TITLE PAGE                               -->
          <!-- ========================================================= -->
          <section class="slide-page active w-full" data-slide="0">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
              <!-- Left Column: Literary Title Block -->
              <div class="lg:col-span-7 space-y-4">
                <div class="ink-write inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#a61c1c]/40 bg-[#a61c1c]/5 text-[#a61c1c] text-xs font-semibold uppercase tracking-widest">
                  <span>Founding Partner Invitation</span>
