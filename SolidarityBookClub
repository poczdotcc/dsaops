      "Sign the Founding Ledger"
    ];

    let currentSlide = 0;
    const slides = document.querySelectorAll('.slide-page');
    const totalSlides = slides.length;
    const tabs = document.querySelectorAll('.bookmark-tab');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const pageCounter = document.getElementById('page-counter');
    const pageDotsContainer = document.getElementById('page-dots');
    const activePenEl = document.getElementById('active-pen');
    const paperSurfaceEl = document.getElementById('paper-surface');

    // =========================================================
    // WEB AUDIO API: SUBTLE FOUNTAIN PEN SCRATCH & PAGE RUSTLE
    // =========================================================
    let inkSoundEnabled = false;
    let audioCtx = null;
    let lastScratchTime = 0;

    function initAudio() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) {
          audioCtx = new AudioContextClass();
        }
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    function playPageTurnSound() {
      if (!inkSoundEnabled) return;
      initAudio();
      if (!audioCtx) return;

      const duration = 0.24;
      const bufferSize = Math.floor(audioCtx.sampleRate * duration);
      const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        data[i] = (Math.random() * 2 - 1) * Math.sin((i / bufferSize) * Math.PI);
      }

      const noise = audioCtx.createBufferSource();
      noise.buffer = buffer;

      const filter = audioCtx.createBiquadFilter();
      filter.type = 'bandpass';
      filter.frequency.setValueAtTime(1100, audioCtx.currentTime);
      filter.Q.value = 1.4;

      const gain = audioCtx.createGain();
      gain.gain.setValueAtTime(0.06, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);

      noise.connect(filter);
      filter.connect(gain);
      gain.connect(audioCtx.destination);
      noise.start();
    }

    function playNibScratch(durationSec = 0.06) {
      if (!inkSoundEnabled) return;
      const now = performance.now();
      if (now - lastScratchTime < 75) return;
      lastScratchTime = now;

      initAudio();
      if (!audioCtx) return;

      const bufferSize = Math.floor(audioCtx.sampleRate * durationSec);
      const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        data[i] = (Math.random() * 2 - 1) * (1 - i / bufferSize);
      }

      const noise = audioCtx.createBufferSource();
      noise.buffer = buffer;

      const filter = audioCtx.createBiquadFilter();
      filter.type = 'highpass';
      filter.frequency.setValueAtTime(2600, audioCtx.currentTime);

      const gain = audioCtx.createGain();
      gain.gain.setValueAtTime(0.018, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.0005, audioCtx.currentTime + durationSec);

      noise.connect(filter);
      filter.connect(gain);
      gain.connect(audioCtx.destination);
      noise.start();
    }

    function toggleInkSound() {
      inkSoundEnabled = !inkSoundEnabled;
      const btn = document.getElementById('sound-toggle-btn');
      if (inkSoundEnabled) {
        initAudio();
        playNibScratch(0.14);
        btn.textContent = '🔊 Ink Sound: On';
        btn.classList.add('bg-[#1e1b18]', 'text-[#f8f2e4]');
      } else {
        btn.textContent = '🔇 Ink Sound: Off';
        btn.classList.remove('bg-[#1e1b18]', 'text-[#f8f2e4]');
      }
    }

    // =========================================================
    // GRANULAR CHARACTER-BY-CHARACTER & SVG PATH FOUNTAIN PEN ENGINE
    // =========================================================
    const SPEED_MODES = [
      { id: 'deliberate', label: 'Pace: Deliberate (Slow)', charMs: 44, lineLiftMs: 190, blockPauseMs: 320, svgMs: 1150 },
      { id: 'brisk', label: 'Pace: Brisk', charMs: 18, lineLiftMs: 70, blockPauseMs: 120, svgMs: 520 },
      { id: 'instant', label: 'Pace: Instant', charMs: 0, lineLiftMs: 0, blockPauseMs: 0, svgMs: 0 }
    ];
    let speedIndex = 0;
    let activeWriteRaf = null;
    let dryTimers = [];

    // Split every [data-write] element into individual character spans while preserving inline tags (<strong>, <em>, <span>)
    function prepareHandwritingSpans() {
      document.querySelectorAll('[data-write]').forEach(el => {
        if (el.dataset.prepared === 'true') return;
        el.dataset.prepared = 'true';

        function wrapNode(node, isRed) {
          if (node.nodeType === Node.TEXT_NODE) {
            const raw = node.textContent;
            if (!raw) return document.createDocumentFragment();
            const frag = document.createDocumentFragment();
            // Split into word tokens and whitespace tokens so line-wrapping stays natural
            const tokens = raw.split(/(\s+)/);
            tokens.forEach(token => {
              if (!token) return;
              if (/^\s+$/.test(token)) {
                const spaceSpan = document.createElement('span');
                spaceSpan.className = 'ink-char';
                spaceSpan.textContent = ' ';
                if (isRed) spaceSpan.dataset.red = '1';
                frag.appendChild(spaceSpan);
              } else {
                const wordWrap = document.createElement('span');
                wordWrap.className = 'ink-word';
                for (const ch of token) {
                  const charSpan = document.createElement('span');
                  charSpan.className = 'ink-char';
                  charSpan.textContent = ch;
                  if (isRed) charSpan.dataset.red = '1';
                  wordWrap.appendChild(charSpan);
                }
                frag.appendChild(wordWrap);
              }
            });
            return frag;
          } else if (node.nodeType === Node.ELEMENT_NODE) {
            const childIsRed = isRed || (node.className && typeof node.className === 'string' && node.className.includes('text-[#a61c1c]'));
            const children = Array.from(node.childNodes);
            children.forEach(child => {
              const replaced = wrapNode(child, childIsRed);
              node.replaceChild(replaced, child);
            });
            return node;
          }
          return node;
        }

        const rootIsRed = el.className && typeof el.className === 'string' && el.className.includes('text-[#a61c1c]');
        Array.from(el.childNodes).forEach(child => {
          const replaced = wrapNode(child, rootIsRed);
          el.replaceChild(replaced, child);
        });
      });
    }

    function stopActiveWriting() {
      if (activeWriteRaf) {
        cancelAnimationFrame(activeWriteRaf);
        activeWriteRaf = null;
      }
      dryTimers.forEach(t => clearTimeout(t));
      dryTimers = [];
      if (activePenEl) {
        activePenEl.style.opacity = '0';
      }
    }

    function positionPenAt(x, y, angleDeg = 0, scale = 1) {
      if (!activePenEl) return;
      activePenEl.style.opacity = '1';
      // Nib tip is anchored at (6px, 112px) inside the 118x118 SVG
      activePenEl.style.left = `${x - 6}px`;
      activePenEl.style.top = `${y - 112}px`;
      activePenEl.style.transform = `rotate(${angleDeg.toFixed(2)}deg) scale(${scale.toFixed(3)})`;
    }

    function runHandwritingOnCurrentSlide() {
      stopActiveWriting();
      const activeSlide = slides[currentSlide];
      if (!activeSlide || !paperSurfaceEl) return;

      const mode = SPEED_MODES[speedIndex];
      const allChars = Array.from(activeSlide.querySelectorAll('.ink-char'));
      const allBoxes = Array.from(activeSlide.querySelectorAll('.ink-box'));
      const allStrokes = Array.from(activeSlide.querySelectorAll('.pen-stroke'));

      // Reset all strokes, boxes, and characters on the active slide
      allBoxes.forEach(box => box.classList.remove('inked'));
      allChars.forEach(ch => {
        ch.classList.remove('wet', 'wet-red', 'dry');
      });

      allStrokes.forEach(stroke => {
        let len = 300;
        try {
          if (typeof stroke.getTotalLength === 'function') {
            len = stroke.getTotalLength();
          }
        } catch (e) {}
        stroke.dataset.pathLen = len;
        stroke.style.strokeDasharray = `${len}`;
        stroke.style.strokeDashoffset = `${len}`;
      });

      // Instant mode: show everything immediately
      if (mode.id === 'instant') {
        allBoxes.forEach(box => box.classList.add('inked'));
        allChars.forEach(ch => ch.classList.add('dry'));
        allStrokes.forEach(stroke => {
          stroke.style.strokeDashoffset = '0';
        });
        return;
      }

      // Build ordered sequence of tasks: SVG illustrations + [data-write] text blocks in reading order
      const sequenceItems = [];
      const svgContainers = Array.from(activeSlide.querySelectorAll('svg'));
      const writeBlocks = Array.from(activeSlide.querySelectorAll('[data-write]'));

      // On Cover (Slide 0), draw the emblem first, then write the title & pitch
      // On other slides, write the header & intro first, then draw diagrams, then remaining notes
      const orderedNodes = [];
      if (currentSlide === 0) {
        svgContainers.forEach(s => orderedNodes.push({ type: 'svg', el: s }));
        writeBlocks.forEach(w => orderedNodes.push({ type: 'write', el: w }));
      } else {
        writeBlocks.slice(0, 3).forEach(w => orderedNodes.push({ type: 'write', el: w }));
        svgContainers.forEach(s => orderedNodes.push({ type: 'svg', el: s }));
        writeBlocks.slice(3).forEach(w => orderedNodes.push({ type: 'write', el: w }));
      }

      orderedNodes.forEach(item => {
        if (item.type === 'svg') {
          const strokes = Array.from(item.el.querySelectorAll('.pen-stroke'));
          strokes.forEach(stroke => {
            sequenceItems.push({
              kind: 'stroke',
              stroke,
              duration: mode.svgMs
            });
          });
        } else {
          const parentBox = item.el.closest('.ink-box');
          const chars = Array.from(item.el.querySelectorAll('.ink-char'));
          if (chars.length > 0) {
            sequenceItems.push({
              kind: 'text',
              el: item.el,
              parentBox,
              chars
            });
          }
        }
      });

      if (sequenceItems.length === 0) {
        allBoxes.forEach(box => box.classList.add('inked'));
        return;
      }

      let itemIdx = 0;
      let charIdx = 0;
      let strokeStartTime = null;
      let pauseUntil = performance.now() + 260;
      let prevLineTop = null;
      let prevPenX = null;
      let prevPenY = null;

      // Smooth pen lift transition state (when moving from end of one line to start of next line)
      let liftAnim = null;

      function revealCharacter(ch) {
        const isRed = ch.dataset.red === '1';
        ch.classList.add(isRed ? 'wet-red' : 'wet');
        const t = setTimeout(() => {
          ch.classList.remove('wet', 'wet-red');
          ch.classList.add('dry');
        }, 360);
        dryTimers.push(t);
      }

      function step(now) {
        const paperRect = paperSurfaceEl.getBoundingClientRect();

        // Handle smooth pen-lift glide between lines or blocks
        if (liftAnim) {
          const p = Math.min(1, (now - liftAnim.start) / liftAnim.duration);
          const ease = 1 - Math.pow(1 - p, 3);
          const curX = liftAnim.fromX + (liftAnim.toX - liftAnim.fromX) * ease;
          const curY = liftAnim.fromY + (liftAnim.toY - liftAnim.fromY) * ease - Math.sin(p * Math.PI) * 14;
          const liftTilt = -8 * Math.sin(p * Math.PI);
          const liftScale = 1 + 0.05 * Math.sin(p * Math.PI);
          positionPenAt(curX, curY, liftTilt, liftScale);
          if (p >= 1) {
            liftAnim = null;
          } else {
            activeWriteRaf = requestAnimationFrame(step);
            return;
          }
        }

        if (now < pauseUntil) {
          activeWriteRaf = requestAnimationFrame(step);
          return;
        }

        if (itemIdx >= sequenceItems.length) {
          // Reveal any remaining boxes and smoothly lift pen off the page
          allBoxes.forEach(box => box.classList.add('inked'));
          if (activePenEl) {
            activePenEl.style.opacity = '0';
          }
          activeWriteRaf = null;
          return;
        }

        const currentItem = sequenceItems[itemIdx];

        if (currentItem.kind === 'stroke') {
          const parentBox = currentItem.stroke.closest('.ink-box');
          if (parentBox) parentBox.classList.add('inked');

          if (!strokeStartTime) strokeStartTime = now;
          const elapsed = now - strokeStartTime;
          const progress = Math.min(1, elapsed / currentItem.duration);
          const eased = progress < 0.5
            ? 2 * progress * progress
            : 1 - Math.pow(-2 * progress + 2, 2) / 2;

          const totalLen = parseFloat(currentItem.stroke.dataset.pathLen || '300');
          currentItem.stroke.style.strokeDashoffset = `${totalLen * (1 - eased)}`;

          try {
            const pt = currentItem.stroke.getPointAtLength(totalLen * eased);
            const svgEl = currentItem.stroke.ownerSVGElement;
            if (svgEl) {
              const ctm = svgEl.getScreenCTM();
              if (ctm) {
                const screenX = pt.x * ctm.a + pt.y * ctm.c + ctm.e;
                const screenY = pt.x * ctm.b + pt.y * ctm.d + ctm.f;
                const localX = screenX - paperRect.left;
                const localY = screenY - paperRect.top;
                const microOsc = Math.sin(now * 0.04) * 1.4;
                positionPenAt(localX, localY, microOsc, 1);
                prevPenX = localX;
                prevPenY = localY;
                playNibScratch(0.05);
              }
            }
          } catch (e) {}

          if (progress >= 1) {
            currentItem.stroke.style.strokeDashoffset = '0';
            strokeStartTime = null;
            itemIdx++;
            pauseUntil = now + 90;
          }
          activeWriteRaf = requestAnimationFrame(step);
          return;
        }

        if (currentItem.kind === 'text') {
          if (currentItem.parentBox) {
            currentItem.parentBox.classList.add('inked');
          }

          if (charIdx >= currentItem.chars.length) {
            itemIdx++;
            charIdx = 0;
            prevLineTop = null;
            pauseUntil = now + mode.blockPauseMs;
            activeWriteRaf = requestAnimationFrame(step);
            return;
          }

          const ch = currentItem.chars[charIdx];
          const chRect = ch.getBoundingClientRect();

          // Detect line wrap (carriage return) so the pen lifts and sweeps back cleanly
          if (prevLineTop !== null && Math.abs(chRect.top - prevLineTop) > 12 && chRect.width > 0) {
            const targetX = chRect.left - paperRect.left + 2;
            const targetY = chRect.top - paperRect.top + chRect.height * 0.74;
            prevLineTop = chRect.top;
            liftAnim = {
              start: now,
              duration: mode.lineLiftMs,
              fromX: prevPenX !== null ? prevPenX : targetX,
              fromY: prevPenY !== null ? prevPenY : targetY,
              toX: targetX,
              toY: targetY
            };
            activeWriteRaf = requestAnimationFrame(step);
            return;
          }

          revealCharacter(ch);

          if (chRect.width > 0 && chRect.height > 0) {
            prevLineTop = chRect.top;
            const penX = chRect.left - paperRect.left + chRect.width * 0.75;
            const baselineY = chRect.top - paperRect.top + chRect.height * 0.75;

            // Realistic hand/wrist up-and-down letter stroke oscillation
            const isSpace = ch.textContent === ' ';
            const strokeWave = isSpace ? -3.5 : Math.sin(charIdx * 2.35) * 3.2;
            const tiltWave = isSpace ? -4 : Math.cos(charIdx * 1.9) * 3.6;

            positionPenAt(penX, baselineY + strokeWave, tiltWave, 1);
            prevPenX = penX;
            prevPenY = baselineY;

            if (!isSpace) {
              playNibScratch(0.05);
            }
          }

          // Slightly linger on punctuation (, . — ! ? :) just like real handwriting
          const txt = ch.textContent;
          let extraPause = 0;
          if (txt === '.' || txt === '!' || txt === '?' || txt === '—') {
            extraPause = mode.charMs * 2.8;
          } else if (txt === ',' || txt === ':' || txt === ';') {
            extraPause = mode.charMs * 1.6;
          } else if (txt === ' ') {
            extraPause = mode.charMs * 0.4;
          }

          charIdx++;
          pauseUntil = now + mode.charMs + extraPause;
          activeWriteRaf = requestAnimationFrame(step);
        }
      }

      activeWriteRaf = requestAnimationFrame(step);
    }

    function replayCurrentPage() {
      const slide = slides[currentSlide];
      if (!slide) return;
      playPageTurnSound();
      runHandwritingOnCurrentSlide();
    }

    function cycleInkSpeed() {
      speedIndex = (speedIndex + 1) % SPEED_MODES.length;
      const btn = document.getElementById('speed-toggle-btn');
      btn.textContent = SPEED_MODES[speedIndex].label;
      runHandwritingOnCurrentSlide();
    }

    // Initialize Pagination Dots
    function initDots() {
      pageDotsContainer.innerHTML = '';
      for (let i = 0; i < totalSlides; i++) {
        const dot = document.createElement('button');
        dot.setAttribute('aria-label', `Go to page ${i + 1}`);
        dot.className = `w-2.5 h-2.5 rounded-full transition-all cursor-pointer ${
          i === currentSlide ? 'bg-[#a61c1c] scale-125' : 'bg-[#1e1b18]/25 hover:bg-[#1e1b18]/50'
        }`;
        dot.onclick = () => goToSlide(i);
        pageDotsContainer.appendChild(dot);
      }
    }

    // Navigate to Specific Slide
    function goToSlide(index) {
      if (index < 0 || index >= totalSlides) return;
      const isChanging = index !== currentSlide;
      currentSlide = index;

      slides.forEach((slide, i) => {
        if (i === currentSlide) {
          slide.classList.remove('active');
          void slide.offsetWidth;
          slide.classList.add('active');
        } else {
          slide.classList.remove('active');
        }
      });

      if (isChanging) {
        playPageTurnSound();
      }

      // Update Bookmark Tabs
      tabs.forEach((tab, i) => {
        if (i === currentSlide) {
          tab.classList.add('active');
          if (i !== 6) {
            tab.style.backgroundColor = '#991b1b';
            tab.style.color = '#fdf6e7';
          }
        } else {
          tab.classList.remove('active');
          if (i !== 6) {
            tab.style.backgroundColor = '#3f2e26';
            tab.style.color = '#f3e9d2';
          }
        }
      });

      // Update Controls & Counter
      prevBtn.disabled = currentSlide === 0;
      nextBtn.disabled = currentSlide === totalSlides - 1;
      pageCounter.textContent = `Page ${currentSlide + 1} of ${totalSlides} — ${slideTitles[currentSlide]}`;

      initDots();
      runHandwritingOnCurrentSlide();

      if (currentSlide === totalSlides - 1) {
        setTimeout(resizeSignatureCanvas, 90);
      }
    }

    function nextSlide() {
      if (currentSlide < totalSlides - 1) {
        goToSlide(currentSlide + 1);
      }
    }

    function prevSlide() {
      if (currentSlide > 0) {
        goToSlide(currentSlide - 1);
      }
    }

    // Interactive Neighborhood Stop Highlight on Page 2
    function highlightNeighborhood(name, desc) {
      const readout = document.getElementById('neighborhood-readout');
      if (!readout) return;
      playNibScratch(0.12);
      readout.innerHTML = `
        <span class="font-bold text-[#a61c1c]">${name}:</span>
        <span class="text-[#2d2722]">${desc}</span>
      `;
    }

    // Keyboard Arrow Support
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') nextSlide();
      if (e.key === 'ArrowLeft') prevSlide();
    });

    // Interactive Slack vs Discord Toggle on Page 4
    function togglePlatform(platform) {
      const btnSlack = document.getElementById('btn-slack');
      const btnDiscord = document.getElementById('btn-discord');
      const preview = document.getElementById('platform-preview');

      if (platform === 'slack') {
        btnSlack.className = 'px-2.5 py-1 bg-[#1e1b18] text-[#f8f2e4] cursor-pointer';
        btnDiscord.className = 'px-2.5 py-1 bg-transparent text-[#1e1b18] cursor-pointer';
        preview.innerHTML = `
          <div class="p-3 rounded-lg bg-[#f8f2e4] border border-[#1e1b18]/15">
            <p class="font-mono-code font-bold text-[#1e1b18]">#three-avenues-book-club</p>
            <p class="text-xs text-[#4a433b] mt-0.5">Managed by DSA Ed Foundation volunteers · Zero moderation headache for your staff</p>
          </div>
          <div class="p-3 rounded-lg bg-[#f8f2e4] border border-[#1e1b18]/15">
            <p class="font-bold text-[#a61c1c]">Why Slack fits Three Avenues:</p>
            <p class="text-base text-[#2c2621] mt-1">
              Your neighborhood readers already have Slack open on their laptops and phones during the workday—meaning one click to RSVP, grab the book from your shop, and jump into chapter threads!
            </p>
          </div>
        `;
      } else {
        btnDiscord.className = 'px-2.5 py-1 bg-[#1e1b18] text-[#f8f2e4] cursor-pointer';
        btnSlack.className = 'px-2.5 py-1 bg-transparent text-[#1e1b18] cursor-pointer';
        preview.innerHTML = `
          <div class="p-3 rounded-lg bg-[#f8f2e4] border border-[#1e1b18]/15">
            <p class="font-mono-code font-bold text-[#1e1b18]">#three-avenues-lounge (Discord Server)</p>
            <p class="text-xs text-[#4a433b] mt-0.5">Voice + text channels set up &amp; moderated if your membership prefers Discord</p>
          </div>
          <div class="p-3 rounded-lg bg-[#f8f2e4] border border-[#1e1b18]/15">
            <p class="font-bold text-[#a61c1c]">Member-Driven Choice:</p>
            <p class="text-base text-[#2c2621] mt-1">
              Whatever platform your readers actually check, we build and manage it for you—and connect your channel to the wider Chicago Solidarity Book Club Union.
            </p>
          </div>
        `;
      }
    }

    // =========================================================
    // INTERACTIVE FOUNTAIN PEN SIGNATURE PAD -> PNG + EMAIL ADAM
    // =========================================================
    const canvas = document.getElementById('signature-pad');
    const ctx = canvas.getContext('2d');
    let isDrawing = false;
    let hasSigned = false;
    let usedTouchFinger = false;
    let autoEmailTimer = null;
    let lastX = 0;
    let lastY = 0;

    function resizeSignatureCanvas() {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;
      const dpr = window.devicePixelRatio || 1;
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.strokeStyle = '#1e1b18';
      ctx.lineWidth = 2.6;

      ctx.save();
      ctx.font = 'italic 15px "Cormorant Garamond", Georgia, serif';
      ctx.fillStyle = 'rgba(74, 67, 59, 0.45)';
      ctx.fillText('x ________________________________________', 18, rect.height - 22);
      ctx.restore();
    }

    function getPointerPos(e) {
      const rect = canvas.getBoundingClientRect();
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;
      return {
        x: clientX - rect.left,
        y: clientY - rect.top
      };
    }

    function startDraw(e) {
      isDrawing = true;
      if (e.touches) {
        usedTouchFinger = true;
      }
      if (autoEmailTimer) {
        clearTimeout(autoEmailTimer);
        autoEmailTimer = null;
      }
      const pos = getPointerPos(e);
      lastX = pos.x;
      lastY = pos.y;
      playNibScratch(0.1);
    }

    function drawStroke(e) {
      if (!isDrawing) return;
      e.preventDefault();
      hasSigned = true;
      const pos = getPointerPos(e);
      ctx.beginPath();
      ctx.moveTo(lastX, lastY);
      ctx.lineTo(pos.x, pos.y);
      ctx.stroke();
      lastX = pos.x;
      lastY = pos.y;
    }

    function endDraw() {
      if (!isDrawing) return;
      isDrawing = false;

      if (hasSigned) {
        applyFoundingStamp();
        const status = document.getElementById('status-message');
        if (usedTouchFinger) {
          status.textContent = 'Finger signature captured! Saving PNG & opening email to Adam…';
          autoEmailTimer = setTimeout(() => {
            sendSignatureToAdam(false);
          }, 1150);
        } else {
          status.textContent = 'Signature inked! Click “Send Signature to Adam” to launch email!';
        }
      }
    }

    canvas.addEventListener('mousedown', startDraw);
    canvas.addEventListener('mousemove', drawStroke);
    window.addEventListener('mouseup', endDraw);

    canvas.addEventListener('touchstart', startDraw, { passive: false });
    canvas.addEventListener('touchmove', drawStroke, { passive: false });
    canvas.addEventListener('touchend', endDraw);

    window.addEventListener('resize', () => {
      if (currentSlide === totalSlides - 1) {
        resizeSignatureCanvas();
      }
    });

    function clearSignaturePad() {
      if (autoEmailTimer) {
        clearTimeout(autoEmailTimer);
        autoEmailTimer = null;
      }
      hasSigned = false;
      usedTouchFinger = false;
      resizeSignatureCanvas();
      document.getElementById('founding-stamp').classList.remove('stamped');
      document.getElementById('status-message').textContent = 'Sign above with your finger to launch email!';
    }

    function applyFoundingStamp() {
      const stamp = document.getElementById('founding-stamp');
      const status = document.getElementById('status-message');
      stamp.classList.add('stamped');
      if (!hasSigned) {
        status.textContent = 'COUNT US IN — Stamped! Welcome to the Union, Three Avenues!';
      }
    }

    function sendSignatureToAdam() {
      applyFoundingStamp();
      const status = document.getElementById('status-message');

      // 1. Download PNG snapshot of the signed ledger (`Three-Avenues-Solidarity-Signature.png`)
      try {
        const exportCanvas = document.createElement('canvas');
        exportCanvas.width = canvas.width;
        exportCanvas.height = canvas.height;
        const eCtx = exportCanvas.getContext('2d');
        eCtx.fillStyle = '#f8f2e4';
        eCtx.fillRect(0, 0, exportCanvas.width, exportCanvas.height);
        eCtx.drawImage(canvas, 0, 0);

        eCtx.save();
        eCtx.strokeStyle = '#a61c1c';
        eCtx.lineWidth = 4;
        eCtx.strokeRect(exportCanvas.width - 295, 18, 270, 76);
        eCtx.fillStyle = '#a61c1c';
        eCtx.font = 'bold 17px Georgia, serif';
        eCtx.fillText('COUNT US IN — FOUNDING PARTNER', exportCanvas.width - 282, 50);
        eCtx.font = '15px Georgia, serif';
        eCtx.fillText('Three Avenues Bookshop · Chicago', exportCanvas.width - 282, 74);
        eCtx.restore();

        const dataUrl = exportCanvas.toDataURL('image/png');
        const link = document.createElement('a');
        link.download = 'Three-Avenues-Solidarity-Signature.png';
        link.href = dataUrl;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      } catch (err) {
        // Proceed cleanly to mailto even if sandbox restricts auto-download
      }

      // 2. Open default email client to Adam's personal address
      const recipient = 'therealadamcornelius@gmail.com';
      const subject = encodeURIComponent('Three Avenues Bookshop x Solidarity Book Club Union — Count Us In!');
      const body = encodeURIComponent(
        "Hey Adam!\n\n" +
        "Three Avenues Bookshop is officially in as a Founding Partner of the Chicago Solidarity Book Club Union!\n\n" +
        "(YES, Adam is giving you his personal email — 'cause that's how not-corporate he wants this to be. It's just solidarity, yo.)\n\n" +
        "Quick notes for getting started:\n" +
        "- Attached: Three-Avenues-Solidarity-Signature.png (saved straight from our signed founding ledger!)\n" +
        "- Let's get our managed Slack channel & shared calendar rolling.\n" +
        "- Also let's chat about zero-work POS integration & that toilet handle fund!\n\n" +
        "In solidarity,\n" +
        "Three Avenues Bookshop (Chicago)"
      );

      status.textContent = 'Signature PNG saved & launching email to Adam!';
      window.location.href = `mailto:${recipient}?subject=${subject}&body=${body}`;
    }

    // Boot presentation cleanly
    window.addEventListener('load', () => {
      prepareHandwritingSpans();
      goToSlide(0);
      resizeSignatureCanvas();
    });
  </script>
</body>
