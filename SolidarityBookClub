      </button>
      <button onclick="goToSlide(3)" data-tab="3" class="bookmark-tab bg-[#3f2e26] text-[#f3e9d2] px-2.5 sm:px-3.5 pt-1.5 pb-3 text-xs sm:text-sm font-serif-book tracking-wide shadow-md cursor-pointer whitespace-nowrap">
