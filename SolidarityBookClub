<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Solidarity Book Club Union — Three Avenues Bookshop Pitch</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Google Fonts: Requested Editorial & Handwriting Pairings -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Homemade+Apple&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />

  <style>
    :root {
      --paper-cream: #f8f2e4;
      --paper-aged: #efe6d1;
      --ink-black: #1e1b18;
      --ink-wet: #0e1d36;
      --ink-red: #a61c1c;
      --ink-red-wet: #6e0d0d;
      --ink-gold: #b58938;
      --rule-blue: rgba(112, 138, 168, 0.22);
      --margin-red: rgba(185, 65, 65, 0.34);
      --cover-leather: #2a1815;
      --cover-cloth: #3b221d;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      background-color: #181412;
      background-image:
        radial-gradient(circle at 20% 20%, rgba(74, 42, 34, 0.35) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(45, 32, 24, 0.45) 0%, transparent 55%),
        repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.015) 0px, rgba(255, 255, 255, 0.015) 2px, transparent 2px, transparent 6px);
      color: var(--ink-black);
      font-family: 'Cormorant Garamond', Georgia, serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow-x: hidden;
    }

    /* Typography Utility Classes */
    .font-display {
      font-family: 'Cormorant Garamond', Georgia, serif;
    }
    .font-serif-book {
      font-family: 'Cormorant Garamond', Georgia, serif;
    }
    .font-hand {
      font-family: 'Caveat', cursive;
    }
    .font-script {
      font-family: 'Homemade Apple', cursive;
    }
    .font-mono-code {
      font-family: 'JetBrains Mono', monospace;
    }

    /* Hardcover Book Outer Binding */
    .book-cover {
      background: linear-gradient(145deg, var(--cover-leather), var(--cover-cloth));
      border-radius: 14px;
      padding: 12px 14px 16px 14px;
      box-shadow:
        0 28px 65px rgba(0, 0, 0, 0.72),
        0 8px 20px rgba(0, 0, 0, 0.5),
        inset 0 1px 1px rgba(255, 235, 205, 0.18),
        inset 0 -2px 6px rgba(0, 0, 0, 0.65);
      border: 1px solid #4e2a23;
      position: relative;
      width: 100%;
      max-width: 1140px;
      transition: transform 0.3s ease;
    }

    @media (min-width: 768px) {
      .book-cover {
        padding: 18px 22px 22px 22px;
        border-radius: 18px;
      }
    }

    /* Stacked Page Edges Effect */
    .book-pages-stack {
      background-color: var(--paper-cream);
      border-radius: 8px;
      position: relative;
      box-shadow:
        3px 3px 0 #e6dac1,
        6px 6px 0 #d8c9aa,
        9px 9px 0 #cbb996,
        0 10px 25px rgba(0, 0, 0, 0.35);
      overflow: hidden;
    }

    /* Parchment Texture & Ruled Lines */
    .paper-surface {
      background-color: var(--paper-cream);
      background-image:
        radial-gradient(ellipse at center, rgba(255, 252, 245, 0.68) 0%, rgba(232, 219, 193, 0.55) 100%),
        linear-gradient(90deg, transparent 54px, var(--margin-red) 54px, var(--margin-red) 55.5px, transparent 55.5px),
        repeating-linear-gradient(
          to bottom,
          transparent 0px,
          transparent 31px,
          var(--rule-blue) 31px,
          var(--rule-blue) 32px
        );
      background-size: 100% 100%, 100% 100%, 100% 32px;
      position: relative;
      min-height: 620px;
    }

    @media (max-width: 640px) {
      .paper-surface {
        background-image:
          radial-gradient(ellipse at center, rgba(255, 252, 245, 0.68) 0%, rgba(232, 219, 193, 0.55) 100%),
          repeating-linear-gradient(
            to bottom,
            transparent 0px,
            transparent 31px,
            var(--rule-blue) 31px,
            var(--rule-blue) 32px
          );
        min-height: 650px;
      }
    }

    /* Center Book Spine / Gutter Shadow */
    .book-spine-shadow {
      pointer-events: none;
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 56px;
      transform: translateX(-50%);
      background: linear-gradient(
        90deg,
        rgba(65, 48, 30, 0) 0%,
        rgba(65, 48, 30, 0.05) 32%,
        rgba(42, 30, 18, 0.14) 50%,
        rgba(65, 48, 30, 0.05) 68%,
        rgba(65, 48, 30, 0) 100%
      );
      z-index: 5;
    }

    /* Ribbon Bookmark Tabs */
    .bookmark-tab {
      transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
      position: relative;
      clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 84%, 0 100%);
    }
    .bookmark-tab:hover {
      transform: translateY(3px);
    }
    .bookmark-tab.active {
      transform: translateY(6px);
      filter: brightness(1.1);
    }

    /* Page Turn Transition */
    .slide-page {
      display: none;
      opacity: 0;
    }

    .slide-page.active {
      display: block;
      animation: pageTurnIn 0.65s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    @keyframes pageTurnIn {
      0% {
        opacity: 0;
        transform: perspective(1200px) rotateY(-5deg) translateX(12px);
      }
      100% {
        opacity: 1;
        transform: perspective(1200px) rotateY(0deg) translateX(0);
      }
    }

    /* Granular Character-by-Character Ink Reveal with Wet-Ink Sheen */
    .ink-word {
      display: inline-block;
      white-space: pre;
    }

    .ink-char {
      display: inline-block;
      opacity: 0;
      transform: translateY(1.5px) scale(0.96);
      transition:
        opacity 0.14s ease-out,
        transform 0.18s ease-out,
        color 0.45s ease-out,
        text-shadow 0.45s ease-out;
    }

    .ink-char.wet {
      opacity: 1;
      transform: translateY(0) scale(1);
      color: var(--ink-wet);
      text-shadow: 0 0 1px rgba(14, 29, 54, 0.38);
    }

    .ink-char.wet-red {
      opacity: 1;
      transform: translateY(0) scale(1);
      color: var(--ink-red-wet);
      text-shadow: 0 0 1px rgba(110, 13, 13, 0.38);
    }

    .ink-char.dry {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    /* Container cards that gently settle in as the pen reaches them */
    .ink-box {
      opacity: 0.15;
      transform: translateY(4px);
      transition: opacity 0.45s ease, transform 0.45s ease;
    }
    .ink-box.inked {
      opacity: 1;
      transform: translateY(0);
    }

    /* 3D-Shaded Gold-Nib Fountain Pen */
    #active-pen {
      position: absolute;
      width: 118px;
      height: 118px;
      pointer-events: none;
      z-index: 50;
      /* Nib tip sits at exact bottom-left corner (6px, 112px) of the 118x118 SVG */
      transform-origin: 6px 112px;
      will-change: transform, left, top, opacity;
      transition: opacity 0.25s ease;
      filter: drop-shadow(5px 9px 7px rgba(26, 17, 10, 0.34));
    }

    #active-pen .ink-drop-pulse {
      animation: inkDropPulse 0.45s infinite alternate ease-in-out;
    }
    @keyframes inkDropPulse {
      0% { transform: scale(0.85); opacity: 0.75; }
      100% { transform: scale(1.25); opacity: 1; }
    }

    /* Handwritten Margin Callout Box */
    .margin-note {
      background: rgba(255, 250, 238, 0.88);
      border: 1.5px dashed rgba(166, 28, 28, 0.48);
      box-shadow: 2px 3px 8px rgba(45, 30, 15, 0.08);
      transform: rotate(-0.8deg);
      transition: transform 0.25s ease;
    }
    .margin-note:hover {
      transform: rotate(0deg) scale(1.01);
    }

    /* Official Red-Ink Stamp */
    .official-stamp {
      border: 3px double var(--ink-red);
      color: var(--ink-red);
      transform: rotate(-4deg) scale(1.45);
      opacity: 0;
      transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      box-shadow: inset 0 0 0 1px rgba(166, 28, 28, 0.3);
    }
    .official-stamp.stamped {
      transform: rotate(-3deg) scale(1);
      opacity: 0.96;
    }

    /* Interactive Signature Pad */
    #signature-pad {
      touch-action: none;
      cursor: crosshair;
      background-image: linear-gradient(to bottom, transparent 84%, rgba(30, 27, 24, 0.25) 85%, transparent 86%);
    }
  </style>
</head>
