<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>A Proposal in Solidarity — DSA Education Foundation × Three Avenues Bookshop</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Literary Serifs + Fountain Pen Script -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Crimson+Pro:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&display=swap" rel="stylesheet">

  <style>
    :root {
      --paper-cream: #f8f2e4;
      --paper-aged: #efe6d1;
      --paper-edge: #e2d5b7;
      --ink-black: #1e1b18;
      --ink-faded: #4a433b;
      --ink-red: #a61c1c;
      --ink-red-bright: #c81e1e;
      --cover-cloth: #2a1815;
      --cover-leather: #3d1e1a;
      --brass-gold: #b58938;
      --rule-blue: rgba(112, 138, 168, 0.22);
      --margin-red: rgba(166, 28, 28, 0.28);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      background-color: #181412;
      background-image:
        radial-gradient(circle at 20% 20%, rgba(74, 42, 34, 0.35) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(45, 32, 24, 0.45) 0%, transparent 55%),
        repeating-linear-gradient(45deg, rgba(255,255,255,0.015) 0px, rgba(255,255,255,0.015) 2px, transparent 2px, transparent 6px);
      color: var(--ink-black);
      font-family: 'Crimson Pro', Georgia, serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow-x: hidden;
    }

    /* Typography Utility Classes */
    .font-display {
      font-family: 'Playfair Display', Georgia, serif;
    }
    .font-serif-book {
      font-family: 'Crimson Pro', Georgia, serif;
    }
    .font-hand {
      font-family: 'Caveat', cursive;
    }

    /* Hardcover Book Outer Binding */
    .book-cover {
      background: linear-gradient(145deg, var(--cover-leather), var(--cover-cloth));
      border-radius: 14px;
      padding: 12px 14px 16px 14px;
      box-shadow:
        0 28px 65px rgba(0, 0, 0, 0.72),
        0 8px 20px rgba(0, 0, 0, 0.5),
        inset 0 1px 1px rgba(255, 235, 205, 0.18),
        inset 0 -2px 6px rgba(0, 0, 0, 0.65);
      border: 1px solid #4e2a23;
      position: relative;
      width: 100%;
      max-width: 1120px;
      transition: transform 0.3s ease;
    }

    @media (min-width: 768px) {
      .book-cover {
        padding: 18px 22px 22px 22px;
        border-radius: 18px;
      }
    }

    /* Stacked Page Edges Effect */
    .book-pages-stack {
      background-color: var(--paper-cream);
      border-radius: 8px;
      position: relative;
      box-shadow:
        /* Right & bottom page thickness */
        3px 3px 0 #e6dac1,
        6px 6px 0 #d8c9aa,
        9px 9px 0 #cbb996,
        0 10px 25px rgba(0, 0, 0, 0.35);
      overflow: hidden;
    }

    /* Parchment Texture & Ruled Lines */
    .paper-surface {
      background-color: var(--paper-cream);
      background-image:
        /* Subtle paper grain & vignette */
        radial-gradient(ellipse at center, rgba(255, 252, 245, 0.65) 0%, rgba(232, 219, 193, 0.55) 100%),
        /* Vertical red margin line on desktop */
        linear-gradient(90deg, transparent 54px, var(--margin-red) 54px, var(--margin-red) 55.5px, transparent 55.5px),
        /* Faint ruled notebook lines */
        repeating-linear-gradient(
          to bottom,
          transparent 0px,
          transparent 31px,
          var(--rule-blue) 31px,
          var(--rule-blue) 32px
        );
      background-size: 100% 100%, 100% 100%, 100% 32px;
      position: relative;
      min-height: 610px;
    }

    @media (max-width: 640px) {
      .paper-surface {
        background-image:
          radial-gradient(ellipse at center, rgba(255, 252, 245, 0.65) 0%, rgba(232, 219, 193, 0.55) 100%),
          repeating-linear-gradient(
            to bottom,
            transparent 0px,
            transparent 31px,
            var(--rule-blue) 31px,
            var(--rule-blue) 32px
          );
        min-height: 640px;
      }
    }

    /* Center Book Spine / Gutter Shadow (visible on larger viewports) */
    .book-spine-shadow {
      pointer-events: none;
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 56px;
      transform: translateX(-50%);
      background: linear-gradient(
        90deg,
        rgba(65, 48, 30, 0) 0%,
        rgba(65, 48, 30, 0.05) 32%,
        rgba(42, 30, 18, 0.14) 50%,
        rgba(65, 48, 30, 0.05) 68%,
        rgba(65, 48, 30, 0) 100%
      );
      z-index: 5;
    }

    /* Ribbon Bookmark Tabs */
    .bookmark-tab {
      transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
      position: relative;
      clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 84%, 0 100%);
    }
    .bookmark-tab:hover {
      transform: translateY(3px);
    }
    .bookmark-tab.active {
      transform: translateY(6px);
      filter: brightness(1.1);
    }

    /* Page Turn & Fountain Pen Writing Animations */
    .slide-page {
      display: none;
      opacity: 0;
    }

    .slide-page.active {
      display: block;
      animation: pageTurnIn 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    @keyframes pageTurnIn {
      0% {
        opacity: 0;
        transform: perspective(1200px) rotateY(-6deg) translateX(14px);
        filter: blur(1px);
      }
      100% {
        opacity: 1;
        transform: perspective(1200px) rotateY(0deg) translateX(0);
        filter: blur(0);
      }
    }

    /* Ink Reveal Effect for Text Blocks */
    .slide-page.active .ink-write {
      opacity: 0;
      animation: inkReveal 0.7s ease-out forwards;
    }
    .slide-page.active .ink-delay-1 { animation-delay: 0.12s; }
    .slide-page.active .ink-delay-2 { animation-delay: 0.26s; }
    .slide-page.active .ink-delay-3 { animation-delay: 0.42s; }
    .slide-page.active .ink-delay-4 { animation-delay: 0.58s; }
    .slide-page.active .ink-delay-5 { animation-delay: 0.74s; }

    @keyframes inkReveal {
      0% {
        opacity: 0;
        transform: translateY(6px);
        clip-path: inset(0 100% 0 0);
      }
      40% {
        opacity: 0.85;
      }
      100% {
        opacity: 1;
        transform: translateY(0);
        clip-path: inset(0 0% 0 0);
      }
    }

    /* Animated SVG Fountain Pen Strokes */
    .pen-stroke {
      stroke-dasharray: 600;
      stroke-dashoffset: 600;
    }
    .slide-page.active .pen-stroke {
      animation: drawInkStroke 1.15s cubic-bezier(0.35, 0, 0.25, 1) forwards;
    }
    .slide-page.active .pen-stroke-delay-1 { animation-delay: 0.35s; }
    .slide-page.active .pen-stroke-delay-2 { animation-delay: 0.65s; }
    .slide-page.active .pen-stroke-delay-3 { animation-delay: 0.9s; }

    @keyframes drawInkStroke {
      to {
        stroke-dashoffset: 0;
      }
    }

    /* Handwritten Margin Callout Box */
    .margin-note {
      background: rgba(255, 250, 238, 0.78);
      border: 1.5px dashed rgba(166, 28, 28, 0.45);
      box-shadow: 2px 3px 8px rgba(45, 30, 15, 0.08);
      transform: rotate(-1.1deg);
      transition: transform 0.25s ease;
    }
    .margin-note:hover {
      transform: rotate(0deg) scale(1.01);
    }

    /* Wax Seal / Rubber Stamp Animation */
    .official-stamp {
      border: 3px double var(--ink-red);
      color: var(--ink-red);
      transform: rotate(-4deg) scale(1.4);
      opacity: 0;
      transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      box-shadow: inset 0 0 0 1px rgba(166, 28, 28, 0.3);
    }
    .official-stamp.stamped {
      transform: rotate(-3deg) scale(1);
      opacity: 0.94;
    }

    /* Interactive Signature Canvas */
    #signature-pad {
      touch-action: none;
      cursor: crosshair;
      background-image: linear-gradient(to bottom, transparent 84%, rgba(30, 27, 24, 0.25) 85%, transparent 86%);
    }

    /* Custom Scrollbar for inner content if needed */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: var(--paper-aged);
    }
    ::-webkit-scrollbar-thumb {
      background: #b8a686;
      border-radius: 3px;
    }
  </style>
</head>
<body class="p-2 sm:p-4 md:p-6 select-none sm:select-auto">

  <!-- Top Ribbon Bookmark Navigation Bar -->
